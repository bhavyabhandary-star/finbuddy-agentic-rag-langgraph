# LLM (Generate node) — Claude is the default; keep this interface-agnostic.
# LLM_PROVIDER selects which one api/main.py actually uses: claude (default),
# huggingface, or ollama — see api/main.py's _default_provider().
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Local-model fallback (verified once, not the default demo path — see build_prompt.md)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Alternative hosted fallback via Hugging Face Inference Providers (used instead
# of Ollama when a paid HF subscription is available) — token from
# https://huggingface.co/settings/tokens (a "Read" token is sufficient)
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# provider="auto" failed with "not supported by any provider you have
# enabled" on a fresh account (verified) -- featherless-ai worked directly
# without needing to enable anything extra in HF settings.
HF_PROVIDER=featherless-ai

# Production FinBuddy scoring API — READ-ONLY consumption, never write back to this repo
FINBUDDY_SCORING_API_BASE_URL=https://bhavyabhandary-finbuddy-scoring.hf.space

# Path to the read-only Risk-Trend artifact copied from finbuddy-project
# (scoring_service/models/artifacts/risk_trend_logreg.joblib) — do not edit that repo
RISK_TREND_ARTIFACT_PATH=./mlops/risk_trend_monitor/artifacts/risk_trend_logreg.joblib

# Setu AA Feed — only needed to pull a FRESH real profile via
# ingestion.setu_feed.pull_fresh_profile() (requires a human to approve
# consent.url in a browser; see that module's docstring). NOT needed to use
# the already-pulled real profile in data/setu_real_profiles.jsonl. Same
# sandbox product as finbuddy-project's own verified integration — sign up at
# https://bridge.setu.co/v2/signup if starting fresh; use the product's own
# Step 2 "Test API keys" panel, not the org-wide Settings > API keys page.
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_CACHED_PROFILE_PATH=./data/setu_real_profiles.jsonl

# Vector store (local, session-scoped per kickoff_prompt.md — not a system of record)
CHROMA_PERSIST_DIR=./chroma_data

# Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# MLflow tracking (Intent Router MLOps loop)
MLFLOW_TRACKING_URI=./mlruns
